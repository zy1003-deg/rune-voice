# =============================================================================
# Rune Voice — Vite frontend environment template
# =============================================================================
#
# Vite reads `.env` / `.env.development` / `.env.production` files at build
# and dev time. Only variables prefixed with `VITE_` are exposed to the
# browser bundle. See https://vitejs.dev/guide/env-and-mode.html
#
# Copy this file to `.env.development` (or `.env.production`) and adjust.
# DO NOT commit real values — `.env*` is gitignored.
#

# Public site URL used for SEO metadata (canonical / og:url / JSON-LD).
# This is baked into the built HTML at build time via Vite's env replacement.
# - For local dev: http://localhost:5173
# - For production: the URL the deployment is served from.
VITE_SITE_URL=http://localhost:5173

# Base URL where the JSON data and audio files are served.
#
# DEFAULT (when unset): `/demo-data`
#   Fresh clones point at the bundled synthetic demo dataset under
#   `web/public/demo-data/`. This dataset ships with the repo and lets you
#   run the SPA end-to-end without any third-party data.
#
# PRODUCTION:
#   Set this to your public CDN / object storage URL where your own dataset
#   is hosted (e.g. `https://your-cdn.example.com/data`).
VITE_API_BASE=/demo-data

# Optional: override the avatar source.
#
# DEFAULT (when unset): `/champion`
#   Avatar files are expected at `web/public/champion/{alias}.png`. The
#   repo does NOT ship portraits — see README for setup options.
#
# ALTERNATIVE:
#   Point this at your own CDN that hosts the avatars you have rights to:
#     VITE_AVATAR_BASE=https://your-cdn.example.com/avatars
# VITE_AVATAR_BASE=

# Optional full URL or local path for the curated quote pool.
# VITE_FEATURED_URL=/data/featured_quotes.json
# Optional splash folder hosting {alias}_0.jpg; otherwise use the portrait.
# VITE_SPLASH_BASE=/splashes
