# Rune Voice — Vite frontend environment template
# Copy to `.env.development` or `.env.production` and adjust as needed.
# Only VITE_-prefixed values are exposed to the browser bundle.

# Public site URL used for canonical and social metadata.
VITE_SITE_URL=http://localhost:5173

# JSON/audio base. The bundled synthetic demo dataset is the safe default.
VITE_API_BASE=/demo-data

# Optional operator-owned avatar host. Leave unset to use /champion.
# VITE_AVATAR_BASE=https://your-cdn.example.com/avatars
