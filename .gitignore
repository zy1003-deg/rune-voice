# ===== Python =====
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/
.nox/
build/
dist/
venv/
.venv/
env/

# Local environment files (templates remain tracked)
.env
.env.*
!.env.example

# ===== Node / Frontend =====
node_modules/
web/node_modules/
web/dist/
web/.vite/

# Vite / npm env files (defensive — Vite already ignores .env*.local by default)
web/.env
web/.env.local
web/.env.development
web/.env.development.local
web/.env.production
web/.env.production.local
web/.env.*.local
!web/.env.example

# Vercel project binding (local-only)
.vercel
web/.vercel/

# ===== Riot / third-party copyrighted assets (defensive) =====
# Champion portraits are derived from Riot/Tencent game assets and must not be checked in.
web/public/champion/
# Defensive placeholders for asset categories we may host later.
web/public/skins/
web/public/splashes/
web/public/audio/
web/public/voices/
# Raw audio / streaming assets
*.wem
*.bnk
*.mp3
*.wav
*.ogg
*.flac
*.m4a
*.aac
*.mp4

# ===== Production data =====
# The production voice-archive dataset — including full transcript JSON,
# the production search index, and the featured-quotes pool — is the
# operator's local data and is intentionally NOT shipped in this repo.
# Demo data lives under web/public/demo-data/ and is the only data that
# ships here.
web/public/data/
# Production sitemap is generated by `web/generate_sitemap.py` for each
# deployment; do not commit a production sitemap.xml artifact.
web/public/sitemap.xml
data/audio/
data/output/
data/generated/
generated/
output/
# Allow the demo-data README even though the rest of the parent path is
# broadly excluded by Vite only when explicitly ignored; .gitignore
# patterns below are directory-prefix-based.
!web/public/demo-data/

# ===== Bundled external tool binaries =====
# vgmstream-cli is an external dependency — install separately from
# https://github.com/vgmstream/vgmstream/releases; do not redistribute.
tools/vgmstream*/
tools/*.zip
tools/*.exe
tools/*.dll
tools/*.so
tools/*.dylib

# ===== Logs / debug output =====
*.log
server.log
debug_*.png
*.dump

# ===== Local-only materials =====
.omc/
Gemini_Generated_Image_*.png
*.psd

# ===== IDE / OS =====
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*.bak
*.tmp
*.orig
