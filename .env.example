# Rune Voice — Python crawler environment template
# Copy to `.env` and replace placeholders with operator-owned values.

# Comma-separated English aliases. Empty = crawl every entity.
LOL_VOICE_CHAMPION_ID_LIST=

# Operator-supplied metadata API and audio CDN endpoints.
LOL_VOICE_API_BASE=
LOL_VOICE_CDN_BASE=

# Local crawler inputs and generated outputs.
LOL_VOICE_AUDIO_STORE_PATH=./data/audio
LOL_VOICE_OUTPUT_PATH=./data/output

# Maximum concurrent crawler requests.
LOL_VOICE_MAX_CONCURRENCY=5

# Local static development server.
LOL_VOICE_SERVE_PORT=8080
LOL_VOICE_SERVE_AUDIO_ROOT=./data/audio
LOL_VOICE_SERVE_DATA_ROOT=./data

# Sitemap generation. Replace example.com for a real deployment.
LOL_VOICE_SITE_BASE_URL=https://example.com
LOL_VOICE_CHAMPIONS_FILE=
LOL_VOICE_SITEMAP_OUT=
